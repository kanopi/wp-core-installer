{
    "name": "kanopi/wp-core-installer",
    "description": "A Composer plugin that safely installs WordPress core files without overwriting project files, and manages .gitignore for all Composer-managed WordPress packages.",
    "type": "composer-plugin",
    "license": "MIT",
    "require": {
        "php": ">=8.0",
        "composer-plugin-api": "^2.0"
    },
    "require-dev": {
        "composer/composer": "^2.0",
        "composer/installers": "^2.0",
        "phpunit/phpunit": "^9.6",
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "conflict": {
        "fancyguy/webroot-installer": "*",
        "johnpbloch/wordpress-core-installer": "*",
        "roots/wordpress-core-installer": "*"
    },
    "autoload": {
        "psr-4": {
            "Kanopi\\Composer\\WordPress\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kanopi\\Composer\\WordPress\\Tests\\": "tests/Unit/"
        }
    },
    "scripts": {
        "test": [
            "@test:unit",
            "@test:integration"
        ],
        "test:unit": "phpunit",
        "test:integration": "bats tests/integration/",
        "analyse": "phpstan analyse --no-progress",
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "test": "Run the unit and integration suites.",
        "test:unit": "Run the PHPUnit unit tests.",
        "test:integration": "Run the bats integration suite (requires bats-core and the composer binary on PATH).",
        "analyse": "Run PHPStan static analysis.",
        "lint": "Check coding standards (PSR-12).",
        "lint:fix": "Fix coding-standard violations that can be fixed automatically.",
        "check": "Run lint, static analysis and all tests."
    },
    "extra": {
        "class": "Kanopi\\Composer\\WordPress\\Plugin"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": false
        }
    }
}
